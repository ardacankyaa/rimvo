root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.bat]
end_of_line = crlf

[*.{ts,tsx,js,mjs,json,css,html,md,yml,yaml}]
end_of_line = lf

[.agents/skills/**]
charset = unset
end_of_line = unset
insert_final_newline = false
trim_trailing_whitespace = false
