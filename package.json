{
  "name": "rimvo",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "description": "A local-first browser DJ console with two decks, creative transitions and stereo WAV/MP3 recording exports.",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite --open",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host localhost --port 5174 --strictPort",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:licenses": "node scripts/check-licenses.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "1.2.7",
    "@soundtouchjs/core": "2.1.1",
    "@soundtouchjs/interpolation-strategy-lanczos": "2.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "dj",
    "web-audio",
    "react",
    "typescript",
    "music"
  ]
}
